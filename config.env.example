# 名将杀 Agent 配置文件（首次启动自动生成，请按需填写）
#
# 核心对战辅助（资料库 / 选将推荐 / 对局攻略的本地计算 + OCR）无需填写以下任何项。
# AI 攻略生成需要 DeepSeek API Key；
# 浏览器抓取（完整版）无需 Key，靠 Edge 登录态。

# ── DeepSeek API（AI 攻略生成用；浏览器抓取模式不需要）──
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 运行时参数 ──
REQUESTS_PER_MINUTE=30
HTTP_TIMEOUT=300
MAX_RETRIES=3
# 单次 AI 请求输出额度 max_tokens（思考+正文共享）；思考型源头按供应商上限调大，超上限会被拒（400）
MAX_OUTPUT_TOKENS=32768

# ── 模拟器 (MuMu) 配置 ──
MUMU_ADB_PATH=
MUMU_ADB_PORT=16448
MUMU_OCR_ENABLED=true
MUMU_OCR_POLL_MODE=true
MUMU_OCR_AUTO_SWITCH_TAB=true
MUMU_OCR_POLL_INTERVAL=2
MUMU_OCR_MATCH_THRESHOLD=0.8
# OCR 主引擎套件：v6=PP-OCRv6-small（默认） v4=PP-OCRv4-mobile（回滚档，复核
# 引擎随之互换为 v6）。两套件均为 RapidOCR/ONNX 形态、固定 CPU 推理。
MUMU_OCR_PRIMARY_ENGINE=v6
# CPU 推理线程数（限制避免打满全部逻辑核心与模拟器抢核）
MUMU_OCR_CPU_THREADS=6
# 复核模式：对未决识别槽位用复核引擎（与主引擎互为异构）做候选内确认，
# 读数不命中候选闭包一律维持原状。v4 套件模型需先运行
# python -m src.scripts.fetch_recheck_models 预取（缺失时复核自动停用）。
MUMU_OCR_RECHECK_ENABLED=false
# 截图模式：auto=raw 优先失败自动回退 PNG（默认，1440p 实测每拍省约 1.3 秒）
#           raw=仅 raw 帧 / png=仅 PNG（排查兼容性问题时用）
MUMU_SCREENSHOT_MODE=auto
MUMU_HERO_SELECTION_THRESHOLD=0.8
MUMU_HERO_SELECTION_COOLDOWN=180
MUMU_MATCH_GUIDE_THRESHOLD=0.6

# ── RAG 攻略知识库（完整版知识库维护页用）──
# 语料/索引在 data/rag_corpus、data/rag_index；模型默认共享 mjs_rag_project 缓存
RAG_ENABLED=true
RAG_MODEL_DIR=
RAG_TOP_K=12
RAG_PROMPT_CHARS=6000

# ── 私有数据仓（pull_data 同步）──
# 抓取/维护数据经私有仓同步，默认在项目同级 mjs_data_private；
# 位置不同时取消注释指定，环境变量 MJS_DATA_REPO 优先级更高
# MJS_DATA_REPO=G:\py_savepoint\mjs_data_private

# ── 数据新鲜度（状态栏芯片）──
# 公告时间轴距今天数超过该值视为不健康，武将新鲜度退化为纯年龄估算；默认 14
# DATA_FRESHNESS_TIMELINE_STALE_DAYS=14
