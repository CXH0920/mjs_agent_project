# 名将杀 Agent 配置文件（首次启动自动生成，请按需填写）
#
# 核心对战辅助（资料库 / 选将推荐 / 对局攻略的本地计算 + OCR）无需填写以下任何项。
# AI 攻略生成需要 DeepSeek API Key；
# 浏览器抓取（完整版）无需 Key，靠 Edge 登录态。

# ── DeepSeek API（AI 攻略生成用；浏览器抓取模式不需要）──
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 运行时参数 ──
REQUESTS_PER_MINUTE=30
HTTP_TIMEOUT=300
MAX_RETRIES=3
# 单次 AI 请求输出额度 max_tokens（思考+正文共享）；思考型模型可按供应商上限调大，如 32768
MAX_OUTPUT_TOKENS=16384

# ── 模拟器 (MuMu) 配置 ──
MUMU_ADB_PATH=
MUMU_ADB_PORT=16448
MUMU_OCR_ENABLED=true
MUMU_OCR_POLL_MODE=true
MUMU_OCR_AUTO_SWITCH_TAB=true
MUMU_OCR_POLL_INTERVAL=2
MUMU_OCR_MATCH_THRESHOLD=0.8
# OCR 推理设备：false=CPU（默认，稳定不卡机） true=GPU（需 CUDA 环境正常，开启前请先验证）
MUMU_OCR_USE_GPU=false
# CPU 推理线程数（限制避免打满全部逻辑核心）
MUMU_OCR_CPU_THREADS=6
MUMU_HERO_SELECTION_THRESHOLD=0.8
MUMU_HERO_SELECTION_COOLDOWN=180
MUMU_MATCH_GUIDE_THRESHOLD=0.6
MUMU_MATCH_GUIDE_COOLDOWN=5

# ── RAG 攻略知识库（完整版知识库维护页用）──
# 语料/索引在 data/rag_corpus、data/rag_index；模型默认共享 mjs_rag_project 缓存
RAG_ENABLED=true
RAG_MODEL_DIR=
RAG_TOP_K=12
RAG_PROMPT_CHARS=6000
RAG_PROJECT_DIR=
