  "counter_chain": {
    "亡语型": "需要最后处理（不要先集火）",
    "卖血/被动收益型": "高爆发型/拆迁型（被打反而赚）",
    "封技能/沉默型": "卖血型/战法牌型（依赖技能的都被克）",
    "拆迁/控牌型": "高过牌型/装备流（拆掉key牌就废）",
    "控制/扰乱型": "节奏型武将（打乱既定策略）",
    "防御/保核型": "高爆发型（能硬吃一轮输出）",
    "高爆发型": "慢运营型/辅助型（不给发育时间）",
    "高过牌/运营型": "防御型（资源碾压，慢慢磨死）"
